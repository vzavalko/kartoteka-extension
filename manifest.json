{
  "manifest_version": 3,
  "name": "ZAKLADKA",
  "version": "1.8.0",
  "description": "Сохраняет текущую вкладку в любую папку ZAKLADKA, показывает открытые вкладки на самой странице и узнаёт настоящие названия страниц.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Сохранить вкладку в ZAKLADKA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "stash-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Сохранить текущую вкладку и закрыть её"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Открыть окно ZAKLADKA"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vzavalko.github.io/zakladka/*",
        "https://vzavalko.github.io/kartoteka/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}