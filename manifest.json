{
  "manifest_version": 3,
  "name": "ZAKLADKA — сдать вкладки",
  "version": "1.3.0",
  "description": "Сдаёт открытые вкладки в ZAKLADKA: копирует их названия и адреса, закрывает вкладки и освобождает память Chrome.",
  "permissions": [
    "tabs",
    "storage",
    "clipboardRead"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Сдать вкладки в ZAKLADKA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "stash-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Сдать текущую вкладку в очередь и закрыть её"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Открыть список вкладок"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vzavalko.github.io/zakladka/*",
        "https://vzavalko.github.io/kartoteka/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}